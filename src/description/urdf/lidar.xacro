<?xml version="1.0"?>
<!--
  360° 2D lidar at the front of the top plate, scan plane ~0.23 m above ground (below the
  planter tops, so the rows, walls and low obstacles are all seen). Mounted at the front so the
  camera mast (right edge, chassis center) only shadows a few rays behind-right.
  Data: /scan (sensor_msgs/msg/LaserScan), frame lidar_link.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_x" value="0.2"/>
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_length" value="0.05"/>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.2" r="${lidar_radius}" h="${lidar_length}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Sits on the 1 cm top plate -->
    <origin xyz="${lidar_x} 0 ${chassis_z + chassis_height/2 + 0.01 + lidar_length/2}" rpy="0 0 0"/>
  </joint>

  <!-- URDF->SDF merges lidar_link into its parent, so gz_frame_id sets the frame_id of the scans -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
