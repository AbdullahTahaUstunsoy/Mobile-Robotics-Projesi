# colcon (folders are kept on GitHub via .gitkeep, their contents are not)
build/*
!build/.gitkeep
install/*
!install/.gitkeep
log/*
!log/.gitkeep

# Python
__pycache__/
*.pyc
*.egg-info/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Generated
frames*.pdf
frames*.gv

# Claude Code local settings
.claude/
